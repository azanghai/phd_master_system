# Used only on the first start, when the SQLite database has no users.
PHD_WORKBENCH_ADMIN_USERNAME=admin
PHD_WORKBENCH_ADMIN_PASSWORD=change-this-to-a-long-random-password

# NAS data directory. Relative paths are resolved from the compose.yaml directory.
# Example absolute path on Feiniu OS:
# PHD_WORKBENCH_DATA_PATH=/vol1/1000/docker/phd-workbench-data
PHD_WORKBENCH_DATA_PATH=./data

# Set both to 1 when accessing through an HTTPS reverse proxy.
PHD_WORKBENCH_COOKIE_SECURE=0
PHD_WORKBENCH_TRUST_PROXY=0

# Public HTTPS origin when using a tunnel or reverse proxy.
# Do not include a trailing slash.
# PHD_WORKBENCH_PUBLIC_ORIGIN=https://phdsys.vip.cpolar.top
PHD_WORKBENCH_PUBLIC_ORIGIN=
